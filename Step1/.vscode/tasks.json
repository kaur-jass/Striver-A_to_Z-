{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run current file with input.txt",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "g++ -std=c++17 \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}\" && \"${fileDirname}\\${fileBasenameNoExtension}\" < input.txt > output.txt && code output.txt"
            ],
            "group": {
                "kind": "build",
                "isDefault": true   
            },
            "problemMatcher": []
        },
        {
            "label": "build and run current file without input.txt",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "g++ -std=c++17 \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}\" && \"${fileDirname}\\${fileBasenameNoExtension}\" > output.txt && code output.txt"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}
